{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/chain-sync", "destination": "/api/investment-expiry-sweep?job=chain-sync" },
    { "source": "/api/chain-link", "destination": "/api/investment-expiry-sweep?job=chain-link" },
    { "source": "/api/fx-oracle", "destination": "/api/investment-expiry-sweep?job=fx-oracle" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/status/:id", "destination": "/api/share-preview?type=status&id=:id" },
    { "source": "/pitchin/:id", "destination": "/api/share-preview?type=pitch&id=:id" },
    { "source": "/icaneracoin", "destination": "/api/share-preview?type=coin" },
    { "source": "/icaneracoin/", "destination": "/api/share-preview?type=coin" },
    { "source": "/icaneracoin/:view(analysis|data|stable|learn)", "destination": "/api/share-preview?type=coin" },
    { "source": "/icaneracoin/:view(analysis|data|stable|learn)/", "destination": "/api/share-preview?type=coin" },
    { "source": "/shop", "destination": "/api/share-preview?type=shop" },
    { "source": "/shop/", "destination": "/api/share-preview?type=shop" },
    { "source": "/store/:id", "destination": "/api/share-preview?type=store&id=:id" },
    { "source": "/notices/:id", "destination": "/api/share-preview?type=notices&id=:id" },
    { "source": "/developers", "destination": "/developers/index.html" },
    { "source": "/developers/", "destination": "/developers/index.html" },
    { "source": "/:slug((?!about$|admin$|api$|app$|assets$|auth$|billing$|buy-ican$|callback$|candidate-document$|candidate-interview$|candidate-test$|card-pay$|careers$|checkout$|confirm-delete-account$|consultation-forms$|contact$|contract$|dashboard$|decoy-portal$|developers$|dist$|document$|drive$|edit$|explore$|favicon$|file$|forms$|health$|help$|home$|icaneracoin$|icons$|images$|index$|invest$|investments$|invite$|jobs$|js$|login$|logout$|manifest$|new$|notice$|notices$|notifications$|null$|official$|open$|pay$|pitch$|pitchin$|plan$|plans$|portfolio$|presentation$|pricing$|privacy$|public$|register$|report-exports$|reports$|reset-password$|reset-pin$|robots$|search$|sell-ican$|service-provider-contract$|settings$|share$|shop$|sign-in$|sign-up$|signin$|signup$|sitemap$|spreadsheets$|staff$|staff-attendance$|stake-ican$|static$|status$|store$|support$|support-console$|sw$|team$|terms$|test-share$|transfer-ican$|undefined$|verify-agreement$|verify-document$|visitor-check-in$|wallet$|www$)[a-z0-9][a-z0-9-]{1,58}[a-z0-9])", "destination": "/api/share-preview?type=site&slug=:slug" },
    { "source": "/((?!api/|developers/|js/|assets/|images/|icons/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/share",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
