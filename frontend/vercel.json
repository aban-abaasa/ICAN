{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/chain-sync", "destination": "/api/investment-expiry-sweep?job=chain-sync" },
    { "source": "/api/chain-link", "destination": "/api/investment-expiry-sweep?job=chain-link" },
    { "source": "/api/fx-oracle", "destination": "/api/investment-expiry-sweep?job=fx-oracle" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/status/:id", "destination": "/api/share-preview?type=status&id=:id" },
    { "source": "/pitchin/:id", "destination": "/api/share-preview?type=pitch&id=:id" },
    { "source": "/icaneracoin", "destination": "/api/share-preview?type=coin" },
    { "source": "/icaneracoin/", "destination": "/api/share-preview?type=coin" },
    { "source": "/icaneracoin/:view(analysis|data|stable|learn)", "destination": "/api/share-preview?type=coin" },
    { "source": "/icaneracoin/:view(analysis|data|stable|learn)/", "destination": "/api/share-preview?type=coin" },
    { "source": "/shop", "destination": "/api/share-preview?type=shop" },
    { "source": "/shop/", "destination": "/api/share-preview?type=shop" },
    { "source": "/store/:id", "destination": "/api/share-preview?type=store&id=:id" },
    { "source": "/notices/:id", "destination": "/api/share-preview?type=notices&id=:id" },
    { "source": "/developers", "destination": "/developers/index.html" },
    { "source": "/developers/", "destination": "/developers/index.html" },
    { "source": "/((?!api/|developers/|js/|assets/|images/|icons/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/share",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
